{
  "name": "@peermetrics/sdk",
  "version": "2.8.0",
  "description": "The peer metrics javascript SDK",
  "main": "dist/index.js",
  "repository": "https://github.com/peermetrics/sdk-js",
  "author": "Andrei Onel <andrei@peermetrics.io>",
  "license": "MIT",
  "scripts": {
    "build": "rollup -c",
    "start": "npm run serve",
    "serve": "http-server . -p 3000 -o /examples",
    "watch": "rollup -c -w",
    "prepublishOnly": "npm run build",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "webrtc",
    "webrtc-stats",
    "stats",
    "rtcpeerconnection",
    "analytics"
  ],
  "dependencies": {
    "@peermetrics/webrtc-stats": "5.9.0",
    "ua-parser-js": "2.0.9",
    "wretch": "2.11.1"
  },
  "devDependencies": {
    "@babel/core": "^7.13.10",
    "@babel/plugin-transform-runtime": "^7.13.10",
    "@babel/preset-env": "^7.13.10",
    "@babel/preset-typescript": "^7.13.0",
    "@rollup/plugin-babel": "^5.3.0",
    "@rollup/plugin-commonjs": "^11.1.0",
    "@rollup/plugin-node-resolve": "^7.1.3",
    "@types/jest": "29.5.12",
    "babel-jest": "29.7.0",
    "babel-preset-minify": "^0.5.1",
    "http-server": "^14.1.1",
    "jest": "29.7.0",
    "jest-environment-jsdom": "^30.3.0",
    "rollup": "^2.51.1",
    "rollup-plugin-license": "^3.7.1",
    "rollup-plugin-node-polyfills": "^0.2.1",
    "rollup-plugin-terser": "^7.0.2",
    "rollup-plugin-ts": "^3.0.2",
    "standard": "^16.0.0",
    "ts-jest": "29.1.5",
    "tslib": "^2.1.0",
    "typescript": "^4.2.3"
  },
  "standard": {
    "ignore": [
      "**/dist/",
      "**/example/"
    ]
  }
}
